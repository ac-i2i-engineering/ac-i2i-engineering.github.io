# Copy to .env.local and fill in with values from the Supabase project
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively in Next.js API routes (e.g. admin invite)
# and admin/scripts/bootstrap-owner.mjs. Bypasses RLS -- must never be
# prefixed with NEXT_PUBLIC_ or reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used as the base URL for the invite email's set-password link.
# Falls back to the request's own origin if unset, so this is only needed
# if that origin is ever wrong (e.g. behind a proxy).
NEXT_PUBLIC_SITE_URL=
